APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Samakan dengan URL di browser (termasuk 127.0.0.1 vs localhost) agar cookie sesi/CSRF tidak 419.
APP_URL=http://127.0.0.1:8000
# URL publik untuk link di email mahasiswa (wajib di hosting: https://domain-anda.com). Kosongkan = pakai APP_URL.
# APP_PUBLIC_URL=https://kampuspay.contoh.ac.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Password default saat admin/kasir mengimpor mahasiswa (fallback ke NPM).
MAHASISWA_DEFAULT_PASSWORD=

# Username kasir placeholder untuk histori pembayaran hasil import (diverifikasi_oleh).
IMPORT_KASIR_USERNAME=kasir_import

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Untuk http:// di lokal; true membuat cookie tidak terkirim → 419.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log = hanya ke storage/logs (tidak sampai inbox). Untuk email nyata: smtp + kredensial.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="KampusPay STTP"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Path absolut/relatif ke JSON service account Firebase (push ke app mahasiswa). Contoh: storage/firebase/service-account.json
# FIREBASE_CREDENTIALS=

VITE_APP_NAME="${APP_NAME}"
